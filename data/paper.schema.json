{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/awesome-reliable-self-evolving-agents/paper.schema.json",
  "title": "Awesome Reliable Self-Evolving Agents work",
  "type": "object",
  "required": [
    "id",
    "title",
    "year",
    "primary_level",
    "primary_subcategory",
    "classification_status",
    "paper_url",
    "artifacts",
    "manuscript",
    "curation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "arxiv_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[a-z-]+/[0-9]{7}|[0-9]{4}\\.[0-9]{4,5})$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "authors_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_level": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        null
      ]
    },
    "primary_subcategory": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification_status": {
      "enum": [
        "strict",
        "facing",
        "mixed",
        "boundary",
        "supporting"
      ]
    },
    "classification_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "paper_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "code_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "project_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "url",
          "relation",
          "source",
          "verification_status",
          "verified_at",
          "http_status"
        ],
        "properties": {
          "kind": {
            "enum": [
              "paper",
              "code",
              "project",
              "dataset",
              "benchmark"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "relation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "source_listed",
              "verified",
              "redirected",
              "rate_limited",
              "blocked",
              "unreachable",
              "invalid"
            ]
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "catalog_source": {
      "type": "object"
    },
    "manuscript": {
      "type": "object",
      "required": [
        "bib_key",
        "bib_key_aliases",
        "cited_bib_keys",
        "active",
        "memberships",
        "representative"
      ],
      "properties": {
        "bib_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "bib_key_aliases": {
          "description": "Other BibTeX keys in the bibliography for this same work.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cited_bib_keys": {
          "description": "Keys the manuscript actually cites this work under.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "memberships": {
          "type": "array"
        },
        "representative": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "link_evidence": {
      "type": "array"
    },
    "curation": {
      "type": "object",
      "required": [
        "metadata_status",
        "link_status",
        "last_verified_at"
      ],
      "properties": {
        "metadata_status": {
          "type": "string"
        },
        "link_status": {
          "type": "string"
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
